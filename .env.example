# Local: npm run dev needs no environment file. Never store secrets in VITE_*.
# npm start does not automatically load .env; export variables or use node --env-file.
HOST=127.0.0.1
PORT=3000
DB_PATH=data/klassno.sqlite
# Production: replace with your actual HTTPS origin. Keep one server instance.
NODE_ENV=production
ALLOWED_ORIGINS=https://YOUR-DOMAIN,capacitor://localhost,http://localhost
PUBLIC_URL=https://YOUR-DOMAIN
# Native only; web builds normally leave VITE_API_URL empty (same origin).
VITE_API_URL=
VITE_WEB_URL=
